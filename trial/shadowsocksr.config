config global 'global'
	option global_server 'nil'
	option udp_relay_server 'same'
	option netflix_server 'nil'
	option netflix_enable '0'
	option threads '1'
	option run_mode 'router'
	option dports '2'
	option pdnsd_enable '1'
	option prefer_nft '1'
	option tunnel_forward '1.1.1.1:53'
	option monitor_enable '1'
	option enable_switch '0'
	option switch_time '60'
	option switch_timeout '5'
	option switch_try_count '3'
	option shunt_dns '0'
	option chinadns_forward 'none'

config server_subscribe 'subscribe'
	option proxy '0'
	option auto_update '0'
	option ss_type 'v2ray'
	option filter_words ''
	option url_test_url 'https://www.google.com/generate_204'
	option user_agent 'v2rayN/9.99'

config access_control 'access'
	option lan_ac_mode '0'
	option router_proxy '1'
	list Interface 'lan'
	list Interface 'zt+'

config socks5_proxy 'socks'
	option enabled '0'
	option server 'nil'
	option local_port '10810'
	option socks5_auth 'noauth'

config server_global 'server'
	option enable_server '0'

config global_xray_fragment 'fragment'
	option fragment '0'
	option noise '0'
