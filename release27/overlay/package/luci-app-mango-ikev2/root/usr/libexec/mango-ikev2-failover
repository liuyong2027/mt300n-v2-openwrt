#!/bin/sh
# One dial attempt for the active IKEv2 server.
# After two failed attempts, switch to the next configured server.
# Short negotiation/rekey windows get a bounded grace period.
# Probe failures are debounced; CHILD repair precedes controlled IKE recovery.
# Optional SSR Plus+ fallback is UCI opt-in and only stops the cycle when the
# helper exists and succeeds; missing helper must not freeze peer rotation.
set -eu
umask 077
STATE="${MANGO_IKEV2_STATE:-/var/etc/mango-ikev2}"
XFRM_IF=xfrm-mango
PROBE_FAIL_LIMIT=3
CHILD_FAIL_LIMIT=3
CONNECTING_GRACE=60
TRANSITION_GRACE=120
FULL_REBUILD_COOLDOWN=300
enabled=$(uci -q get mango_ikev2.main.enabled || true)
mode=$(uci -q get mango_ikev2.main.mode || true)
[ "$enabled" = 1 ] || exit 0
[ -n "$mode" ] && [ "$mode" != direct ] || exit 0

server2=$(uci -q get mango_ikev2.main.server2 || true)
server3=$(uci -q get mango_ikev2.main.server3 || true)
mkdir -p "$STATE"
exec 9>"$STATE/failover.lock"
flock -n 9 || exit 0
active=$(cat "$STATE/active" 2>/dev/null || echo mango)
case "$active" in
	mango|mango2|mango3) ;;
	*) active=mango ;;
esac
[ "$active" = mango2 ] && [ -z "$server2" ] && active=mango
[ "$active" = mango3 ] && [ -z "$server3" ] && active=mango

peer_label() {
	case "$1" in
		mango2) printf '%s' '备用服务器1' ;;
		mango3) printf '%s' '备用服务器2' ;;
		*) printf '%s' '主服务器' ;;
	esac
}

PEERS='mango'
[ -n "$server2" ] && PEERS="$PEERS mango2"
[ -n "$server3" ] && PEERS="$PEERS mango3"

next_peer() {
	local cur="$1" first='' seen=0 p
	for p in $PEERS; do
		[ -z "$first" ] && first=$p
		if [ "$seen" = 1 ]; then
			printf '%s' "$p"
			return 0
		fi
		[ "$p" = "$cur" ] && seen=1
	done
	printf '%s' "$first"
}

log_event() {
	/usr/libexec/mango-ikev2-log "$@" 2>/dev/null || true
}

record_health() {
    printf '%s %s\n' "$1" "$(cut -d. -f1 /proc/uptime)" > "$STATE/health-up.tmp"
    mv "$STATE/health-up.tmp" "$STATE/health-up"
}

clear_fallback_fail() {
	rm -f "$STATE/retry-after"
	echo 0 > "$STATE/fallback-fail"
}

bump_fallback_fail() {
	local t thr
	t=$(cat "$STATE/fallback-fail" 2>/dev/null || echo 0)
	case "$t" in
		''|*[!0-9]*) t=0 ;;
	esac
	t=$((t + 1))
	echo "$t" > "$STATE/fallback-fail"
	# Opt-in only: unset UCI must not invent SSR fallback or a default of 6.
	[ "$(uci -q get mango_ikev2.main.ssr_fallback || echo 0)" = 1 ] || return 0
	# Without the helper, never abort — keep IKEv2 peer rotation running.
	[ -x /usr/libexec/mango-ikev2-fallback-ssr ] || return 0
	thr=$(uci -q get mango_ikev2.main.ssr_fallback_fails || echo 0)
	case "$thr" in
		''|*[!0-9]*) thr=0 ;;
	esac
	[ "$thr" -lt 1 ] && return 0
	if [ "$t" -ge "$thr" ]; then
		# Exit the watch cycle only when SSR fallback actually succeeds.
		if /usr/libexec/mango-ikev2-fallback-ssr; then
			exit 0
		fi
	fi
}

# Drop tunnel VIP before IKE dial so charon cannot source from 10.x.
clear_vip() {
	if ip link show "$XFRM_IF" >/dev/null 2>&1; then
		ip -4 addr flush dev "$XFRM_IF" 2>/dev/null || true
	fi
}

refresh_wan_bind() {
	mkdir -p "$STATE" /etc/swanctl/conf.d
	/usr/libexec/mango-ikev2-generate swanctl > "$STATE/swanctl.conf" || return 1
	ln -sf "$STATE/swanctl.conf" /etc/swanctl/conf.d/mango.conf
	swanctl --load-all --noprompt >/dev/null 2>&1 || return 1
}

prepare_dial() {
	/usr/libexec/mango-ikev2-link || return 1
	/usr/libexec/mango-ikev2-cleanup || return 1
	clear_vip
	refresh_wan_bind
}

# Preserve the old snapshot on a query error; never mistake an unavailable
# VICI socket for an empty set of SAs.
read_sas() {
    local output
    output=$(swanctl --list-sas 2>/dev/null) || return 1
    sas=$output
}

peer_block() {
    printf '%s\n' "$sas" | awk -v p="$1" '
        /^[^[:space:]]/ { show = (index($0, p ": ") == 1) }
        show { print }
    '
}

# healthy: an INSTALLED child is up (even if another child is still REKEYED).
# connecting/transition: initial negotiation or rekey/delete needs a grace period.
# child: IKE is ESTABLISHED but no child is installed or in transition.
# down: no usable IKE SA.
sa_health() {
	local peer="$1" block
	block=$(peer_block "$peer")
	if ! printf '%s\n' "$block" | grep -E -q "^${peer}: .*ESTABLISHED"; then
		if printf '%s\n' "$block" | grep -E -q "^${peer}: .*CONNECTING,"; then
            printf '%s\n' connecting
            return 0
        fi
		if printf '%s\n' "$block" | grep -E -q "^${peer}: .*(CREATED|PASSIVE|REKEYING|REKEYED|DELETING|DESTROYING),"; then
            printf '%s\n' transition
            return 0
        fi
		printf '%s\n' down
		return 0
	fi
	if printf '%s\n' "$block" | grep -E -q '(^|[[:space:],])INSTALLED(,|[[:space:]]|$)'; then
		printf '%s\n' healthy
		return 0
	fi
	if printf '%s\n' "$block" | grep -E -q '(^|[[:space:],])(REKEYING|REKEYED|DELETING|INSTALLING|UPDATING|DESTROYING)(,|[[:space:]]|$)'; then
		printf '%s\n' transition
		return 0
	fi
	printf '%s\n' child
	return 0
}

established() {
	[ "$(sa_health "$1")" = healthy ]
}

# strongSwan installs the NordVPN address on the WAN interface. Masquerade
# onto xfrm-mango needs that address on the tunnel device itself.
# Never flush when the VIP is already correct: ip addr flush drops conntrack
# for SNAT/masquerade sourced from that address and breaks long-lived flows.
pin_vip() {
	local vip="$1" cidr have_vip=0
	[ -n "$vip" ] || return 1
	ip link show "$XFRM_IF" >/dev/null 2>&1 || return 1
	for cidr in $(ip -4 -o addr show dev "$XFRM_IF" 2>/dev/null | awk '{print $4}'); do
		if [ "$cidr" = "$vip/32" ]; then
			have_vip=1
		else
			ip -4 addr del "$cidr" dev "$XFRM_IF" 2>/dev/null || return 1
		fi
	done
	[ "$have_vip" = 1 ] || ip addr replace "$vip/32" dev "$XFRM_IF"
}

# Split egress uses mark→table 101→xfrm; dnsmasq uses main table so GFW DNS
# needs /32s on xfrm. Teardown/redial/link flaps drop these — reinstall while up.
ensure_dns_routes() {
    ip -4 route replace default dev "$XFRM_IF" table 101 || return 1
    ip -4 rule show | grep -q '10001:.*fwmark 0x101.*lookup 101' ||
        ip -4 rule add priority 10001 fwmark 0x101/0xffffffff table 101 || return 1
    ip -4 route replace 1.1.1.1/32 dev "$XFRM_IF" || return 1
    ip -4 route replace 8.8.8.8/32 dev "$XFRM_IF"
}

# VIP for one peer only: prefer INSTALLED child local x/32, else IKE [vip].
# Never take the first VIP from a multi-peer swanctl dump.
# Bracketed UDP ports like [4500] are not VIPs — require a dotted IPv4.
peer_vip() {
	local peer="$1" block vip
	block=$(peer_block "$peer")
	vip=$(printf '%s\n' "$block" | sed -n 's/^    local  \([0-9][0-9.]*\)\/32$/\1/p' | head -n 1)
	case "$vip" in
		*.*.*.*) ;;
		*) vip= ;;
	esac
	if [ -z "$vip" ]; then
		vip=$(printf '%s\n' "$block" | sed -n 's/^  local .*\[\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)\]$/\1/p' | head -n 1)
	fi
	printf '%s' "$vip"
}

read_uint() {
    local value
    value=$(cat "$1" 2>/dev/null || true)
    case "$value" in ''|*[!0-9]*) value=0 ;; esac
    [ "${#value}" -le 9 ] || value=0
    while [ "${value#0}" != "$value" ]; do value=${value#0}; done
    printf '%s' "${value:-0}"
}

increment() {
    local value
    value=$(read_uint "$1")
    value=$((value + 1))
    echo "$value" > "$1"
    printf '%s' "$value"
}

clear_peer_tracking() {
    rm -f "$STATE/probe-fail-$1" "$STATE/child-fail-$1" \
        "$STATE/transition-$1" "$STATE/full-pending-$1"
    # Keep full-after across brief healthy periods to prevent recovery storms.
}

https_ok() {
    local code
    # Fixed tunnel-routed IPs avoid bootstrap DNS. Keep SNI and CA validation;
    # never follow redirects or an inherited proxy onto a different route.
    code=$(curl --ipv4 --silent --show-error --output /dev/null \
        --write-out '%{http_code}' --interface "$XFRM_IF" --noproxy '*' \
        --proto '=https' --connect-timeout 3 --max-time 5 \
        --resolve "$1:443:$2" "https://$1/" 2>/dev/null) || return 1
    case "$code" in 2[0-9][0-9]|3[0-9][0-9]) return 0 ;; esac
    return 1
}

datapath_ok() {
    ip link show "$XFRM_IF" >/dev/null 2>&1 || return 1
    ping -c 1 -W 2 -I "$XFRM_IF" 1.1.1.1 >/dev/null 2>&1 && return 0
    ping -c 1 -W 2 -I "$XFRM_IF" 8.8.8.8 >/dev/null 2>&1 && return 0
    https_ok cloudflare-dns.com 1.1.1.1 && return 0
    https_ok dns.google 8.8.8.8
}

probe_failed() {
    local count lvl
    count=$(increment "$STATE/probe-fail-$active")
    # The tunnel is still up below the limit. Only the miss that reaches it
    # is a failure and may start CHILD repair.
    if [ "$count" -ge "$PROBE_FAIL_LIMIT" ]; then
        lvl=fail
    else
        lvl=warn
    fi
    log_event "$lvl" "$active" "tunnel probes failed ($count/$PROBE_FAIL_LIMIT)"
    [ "$count" -ge "$PROBE_FAIL_LIMIT" ]
}

transition_grace() {
    local peer="$1" phase="$2" since= kind= now limit
    now=$(cut -d. -f1 /proc/uptime)
    if [ -r "$STATE/transition-$peer" ]; then
        read -r since kind < "$STATE/transition-$peer" || true
    fi
    case "$since" in ''|*[!0-9]*) since=$now; kind= ;; esac
    [ "${#since}" -le 9 ] || { since=$now; kind=; }
    [ "$since" -le "$now" ] || { since=$now; kind=; }
    case "$kind" in connecting|transition) ;; *)
        since=$now
        kind=$phase
        printf '%s %s\n' "$since" "$kind" > "$STATE/transition-$peer"
        log_event backoff "$peer" "negotiation grace started ($kind)"
        ;;
    esac
    limit=$TRANSITION_GRACE
    [ "$kind" != connecting ] || limit=$CONNECTING_GRACE
    [ $((now - since)) -lt "$limit" ]
}

begin_connecting() {
    printf '%s connecting\n' "$(cut -d. -f1 /proc/uptime)" > "$STATE/transition-$1"
}

mark_connected() {
    local peer="$1" note="$2" prev_probe
    # Read first: clear_peer_tracking deletes the counter. Same-peer recovery
    # must still log ok. Logging only when logged-up changes left the last
    # success row stuck after a debounced probe miss.
    prev_probe=$(read_uint "$STATE/probe-fail-$peer")
    echo 0 > "$STATE/fail-count"
    clear_fallback_fail
    clear_peer_tracking "$peer"
    echo "$peer" > "$STATE/active"
    record_health "$peer"
    if [ "$(cat "$STATE/logged-up" 2>/dev/null || true)" != "$peer" ]; then
        log_event ok "$peer" "$note"
    fi
    echo "$peer" > "$STATE/logged-up"
    if [ "$prev_probe" -gt 0 ]; then
        log_event ok "$peer" "probe recovered after $prev_probe failed"
    fi
    return 0
}

# 0 = verified datapath, 2 = bounded negotiation in progress, 3 = unknown SA
# state, 1 = an observed failure. A grace period is never reported as success.
mark_up() {
    local peer="$1" note="$2" health vip
    read_sas || return 3
    health=$(sa_health "$peer")
    case "$health" in
        connecting|transition)
            transition_grace "$peer" "$health" && return 2
            return 1
            ;;
        healthy)
            rm -f "$STATE/transition-$peer"
            vip=$(peer_vip "$peer")
            if pin_vip "$vip" && ensure_dns_routes && datapath_ok; then
                mark_connected "$peer" "$note vip=${vip:-?}"
                return 0
            fi
            ;;
        child|down) rm -f "$STATE/transition-$peer" ;;
    esac
    return 1
}

record_failure() {
    local reason="$1" count streak delay=30 repairs from now
    if [ "${2:-}" = repair ]; then
        repairs=$(increment "$STATE/child-fail-$active")
        if [ "$peer_count" -eq 1 ] && [ "$repairs" -ge "$CHILD_FAIL_LIMIT" ]; then
            echo 1 > "$STATE/full-pending-$active"
        fi
    fi
    count=$(increment "$STATE/fail-count")
    echo "$active" > "$STATE/active"
    log_event fail "$active" "$reason (#$count)"
    bump_fallback_fail
    streak=$(read_uint "$STATE/fallback-fail")
    # Three failed attempts per tier: 30x3, 60x3, 120x3, 240x3, then 300.
    while [ "$streak" -gt 3 ] && [ "$delay" -lt 300 ]; do
        delay=$((delay * 2))
        streak=$((streak - 3))
    done
    [ "$delay" -le 300 ] || delay=300
    now=$(cut -d. -f1 /proc/uptime)
    echo $((now + delay)) > "$STATE/retry-after"
    log_event backoff "$active" "retry in ${delay}s"
    if [ "$count" -ge 2 ] && [ "$peer_count" -ge 2 ]; then
        from=$active
        active=$(next_peer "$active")
        echo "$active" > "$STATE/active"
        echo 0 > "$STATE/fail-count"
        clear_peer_tracking "$active"
        log_event switch "$active" "节点切换 $(peer_label "$from") → $(peer_label "$active")"
        # The next full dial must confirm cleanup of *all* Mango SAs first.
    fi
}

claim_full_rebuild() {
    local now after
    now=$(cut -d. -f1 /proc/uptime)
    after=$(read_uint "$STATE/full-after-$active")
    if [ "$now" -lt "$after" ]; then
        log_event backoff "$active" "full IKE recovery cooldown: $((after - now))s"
        return 1
    fi
    echo $((now + FULL_REBUILD_COOLDOWN)) > "$STATE/full-after-$active"
    return 0
}

full_dial() {
    local result
    rm -f "$STATE/logged-up" "$STATE/health-up"
    if ! prepare_dial; then
        record_failure 'full dial cleanup/setup unconfirmed'
        return 0
    fi
    clear_peer_tracking "$active"
    begin_connecting "$active"
    swanctl --initiate --ike "$active" --child "$active" --timeout 15 >/dev/null 2>&1 || true
    if mark_up "$active" connected; then
        return 0
    else
        result=$?
    fi
    case "$result" in
        2) return 0 ;;
        3) log_event fail "$active" 'SA query unavailable after dial; defer'; return 0 ;;
    esac
    if [ "$(sa_health "$active")" = healthy ]; then
        # CHILD installed but no datapath proof yet: debounce before repairing.
        probe_failed || true
        return 0
    fi
    record_failure 'dial failed'
}

repair_child() {
    local result
    rm -f "$STATE/logged-up" "$STATE/health-up"
    if [ "$peer_count" -eq 1 ] && [ -f "$STATE/full-pending-$active" ]; then
        if claim_full_rebuild; then
            log_event fail "$active" 'CHILD repairs exhausted; controlled full IKE recovery'
            full_dial
        fi
        return 0
    fi
    log_event fail "$active" 'repairing CHILD only'
    swanctl --initiate --child "$active" --timeout 15 >/dev/null 2>&1 || true
    if mark_up "$active" connected; then
        return 0
    else
        result=$?
    fi
    case "$result" in
        2) return 0 ;;
        3) log_event fail "$active" 'SA query unavailable after CHILD repair; defer'; return 0 ;;
    esac
    record_failure 'CHILD repair failed' repair
}

expired_transition() {
    local phase="$1" fresh
    # Recheck before teardown: a newly INSTALLED child wins over an old timer.
    read_sas || { log_event fail "$active" 'SA query unavailable during recovery'; return 0; }
    fresh=$(sa_health "$active")
    case "$fresh" in
        healthy|child|down) rm -f "$STATE/transition-$active"; return 0 ;;
    esac
    transition_grace "$active" "$fresh" && return 0
    if [ "$phase" != connecting ]; then
        claim_full_rebuild || return 0
    fi
    rm -f "$STATE/logged-up" "$STATE/health-up"
    if /usr/libexec/mango-ikev2-cleanup "$active"; then
        rm -f "$STATE/transition-$active"
        record_failure 'negotiation grace expired; old SA removed'
    else
        record_failure 'negotiation grace expired; SA cleanup unconfirmed'
    fi
    # No flush or new initiate here. Respect backoff, then use the full-dial
    # cleanup barrier again before changing the shared xfrm VIP.
}

peer_count=0
for p in $PEERS; do peer_count=$((peer_count + 1)); done
sas=
if ! read_sas; then
    log_event fail "$active" 'SA query unavailable; defer without changing VIP'
    exit 0
fi
health=$(sa_health "$active")
case "$health" in
    connecting|transition)
        if transition_grace "$active" "$health"; then exit 0; fi
        # Keep observing the original grace clock during backoff, but do not
        # repeat termination on every watchdog tick if cleanup is stuck.
        now=$(cut -d. -f1 /proc/uptime)
        retry=$(read_uint "$STATE/retry-after")
        [ "$now" -ge "$retry" ] || exit 0
        expired_transition "$health"
        exit 0
        ;;
    *) rm -f "$STATE/transition-$active" ;;
esac

now=$(cut -d. -f1 /proc/uptime)
retry=$(read_uint "$STATE/retry-after")
[ "$now" -ge "$retry" ] || exit 0

case "$health" in
    healthy)
        for p in $PEERS; do
            [ "$p" = "$active" ] && continue
            if [ -n "$(peer_block "$p")" ]; then
                /usr/libexec/mango-ikev2-cleanup "$p" || \
                    log_event fail "$p" 'inactive SA cleanup unconfirmed'
            fi
        done
        read_sas || exit 0
        # Cleanup of another peer can coincide with a rekey of the active peer.
        health=$(sa_health "$active")
        case "$health" in
            connecting|transition) transition_grace "$active" "$health" || expired_transition "$health"; exit 0 ;;
            healthy) ;;
            *) exit 0 ;;
        esac
        vip=$(peer_vip "$active")
        if pin_vip "$vip" && ensure_dns_routes && datapath_ok; then
            mark_connected "$active" "connected vip=${vip:-?}"
            exit 0
        fi
        probe_failed || exit 0
        repair_child
        ;;
    child)
        vip=$(peer_vip "$active")
        if [ -n "$vip" ]; then
            if ! pin_vip "$vip" || ! ensure_dns_routes; then
                record_failure 'CHILD setup failed' repair
                exit 0
            fi
            repair_child
        else
            log_event fail "$active" 'IKE up without VIP; confirmed cleanup before full redial'
            full_dial
        fi
        ;;
    down) full_dial ;;
esac
exit 0
