#!/bin/sh
[ "$INTERFACE" = wan ] || exit 0
case "$ACTION" in
    ifup) ;;
    ifupdate) [ "${IFUPDATE_ADDRESSES:-0}" = 1 ] || exit 0 ;;
    *) exit 0 ;;
esac
[ "$(uci -q get mango_ikev2.main.enabled)" = 1 ] || exit 0
[ "$(uci -q get mango_ikev2.main.mode)" != direct ] || exit 0
# Leave netifd free while charon loads and the tunnel is probed.
(
    mkdir -p /var/lock
    exec 7>/var/lock/mango-ikev2-wan.lock
    flock -w 60 7 || exit 0
    sleep 2
    [ "$(uci -q get mango_ikev2.main.enabled)" = 1 ] || exit 0
    /etc/init.d/mango_ikev2 reload
) >/dev/null 2>&1 &
