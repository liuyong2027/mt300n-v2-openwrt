#!/usr/bin/lua
local uci = require('uci').cursor()
local model = dofile('/usr/lib/mango-ikev2/model.lua')
local action = arg[1]
local p = uci:get_all('mango_ikev2', 'main') or {mode = 'split', enabled = '0'}

local function read_lines(path)
    local list, file = {}, io.open(path, 'r')
    if not file then return list end
    for line in file:lines() do
        if line ~= '' then list[#list + 1] = line end
    end
    file:close()
    return list
end

if action == 'nft' and p.mode == 'split' then
    local list = read_lines('/etc/mango-ikev2/cn-cidrs.txt')
    if #list == 0 then list = read_lines('/etc/mango-rules/cn-cidrs.txt') end
    p.cn_cidrs = list
end
if action == 'dnsmasq' and p.mode == 'gfw' then
    p.gfw_domains = read_lines('/etc/mango-ikev2/gfw-domains.txt')
end

if action == 'swanctl' then
    io.write(model.swanctl(p))
elseif action == 'nft' then
    io.write(model.nft(p))
elseif action == 'dnsmasq' then
    io.write(model.dnsmasq(p))
elseif action == 'dns-routes' then
    if p.enabled == '1' and p.mode ~= 'direct' then
        for _, address in ipairs(model.tunnel_dns) do io.write(address, '\n') end
    end
elseif action == 'gfw-convert' then
    local text = io.read('*a')
    local output = model.convert_gfwlist(text)
    io.write(output)
elseif action == 'policy' then
    local q = model.policy(p)
    io.write(q.enabled and '1' or '0', ' ', q.mode, ' ', tostring(q.ifid), ' ', tostring(q.mtu), '\n')
else
    error('Unknown operation')
end
