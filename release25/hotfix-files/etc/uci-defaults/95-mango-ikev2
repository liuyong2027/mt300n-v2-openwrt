#!/bin/sh
uci -q batch <<'EOF'
set firewall.mango_ikev2=include
set firewall.mango_ikev2.type='script'
set firewall.mango_ikev2.path='/usr/libexec/mango-ikev2-fw'
set firewall.mango_ikev2.fw4_compatible='1'
set firewall.mango_ikev2_mark=rule
set firewall.mango_ikev2_mark.name='Mango IKEv2 marked input'
set firewall.mango_ikev2_mark.src='*'
set firewall.mango_ikev2_mark.proto='tcp udp'
set firewall.mango_ikev2_mark.mark='0x101/0xffffffff'
set firewall.mango_ikev2_mark.family='ipv4'
set firewall.mango_ikev2_mark.target='ACCEPT'

# ZeroTier zone (migrated from legacy mango-proxy defaults).
set firewall.mangozt=zone
set firewall.mangozt.name='mangozt'
set firewall.mangozt.input='ACCEPT'
set firewall.mangozt.output='ACCEPT'
set firewall.mangozt.forward='REJECT'
set firewall.mangozt.masq='1'
set firewall.mangozt.mtu_fix='1'
set firewall.mangozt.device='zt+'

delete firewall.zt_to_wan
set firewall.zt_to_wan=forwarding
set firewall.zt_to_wan.src='mangozt'
set firewall.zt_to_wan.dest='wan'

# Ensure lan -> mangozt exists once.
EOF

if ! uci -q show firewall | grep -q "dest='mangozt'"; then
	idx=$(uci add firewall forwarding)
	uci set "firewall.$idx.src=lan"
	uci set "firewall.$idx.dest=mangozt"
fi

uci -q batch <<'EOF'
delete firewall.allow_zt_udp
set firewall.allow_zt_udp=rule
set firewall.allow_zt_udp.name='Allow-ZeroTier-Direct'
set firewall.allow_zt_udp.src='wan'
set firewall.allow_zt_udp.proto='udp'
set firewall.allow_zt_udp.dest_port='9993'
set firewall.allow_zt_udp.target='ACCEPT'
commit firewall
EOF

if ! uci -q show ucitrack | grep -q "init='mango_ikev2'"; then
	idx=$(uci add ucitrack mango_ikev2)
	uci set "ucitrack.$idx.init=mango_ikev2"
	uci commit ucitrack
fi

# Prefer IKEv2 client service on this image; Xray package is absent in the ikev2 profile.
/etc/init.d/xray stop 2>/dev/null || :
/etc/init.d/xray disable 2>/dev/null || :
/etc/init.d/mango_proxy stop 2>/dev/null || :
/etc/init.d/mango_proxy disable 2>/dev/null || :
/etc/init.d/mango_ikev2 enable
exit 0
