#!/bin/sh /etc/rc.common
START=99
STOP=01
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'cudy,tr3600-v1' ] || return 0
	[ ! -e /tmp/.failsafe ] && [ ! -e /var/run/cudy-led/suspend ] || return 0
	/usr/libexec/cudy-led-control validate || return 1
	mkdir -p /var/run/cudy-led
	chmod 700 /var/run/cudy-led
	rm -f /var/run/cudy-led/stopped
	[ "$(uci -q get cudy_led.main.mode)" != default ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/cudy-led-run
	procd_set_param respawn 3600 5 3
	procd_set_param term_timeout 3
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
stop_service() {
	mkdir -p /var/run/cudy-led
	touch /var/run/cudy-led/stopped
}
service_stopped() {
	# The stopped marker makes the loop exit; wait for its lock before restoring.
	[ ! -e /var/run/cudy-led/suspend ] || return 0
	flock -w 5 /var/lock/cudy-led.lock /usr/libexec/cudy-led-control restore
}
reload_service() { restart; }
service_triggers() { procd_add_reload_trigger cudy_led; }
