{
  "admin/network/wireless": {
    "action": {"type": "firstchild"},
    "depends": {"acl": ["luci-mod-network-config"], "uci": {"wireless": {"@wifi-device": true}}}
  },
  "admin/network/wireless/settings": {
    "title": "无线设置", "order": 10,
    "action": {"type": "view", "path": "network/wireless"},
    "depends": {"acl": ["luci-mod-network-config"], "uci": {"wireless": {"@wifi-device": true}}}
  },
  "admin/network/wireless/unified": {
    "title": "Wi-Fi 双频合一", "order": 20,
    "action": {"type": "view", "path": "cudy-wifi"},
    "depends": {"acl": ["luci-app-cudy-wifi"], "uci": {"cudy_wifi": true}}
  },
  "admin/network/cudy-wifi": {
    "action": {"type": "alias", "path": "admin/network/wireless/unified"},
    "depends": {"acl": ["luci-app-cudy-wifi"], "uci": {"cudy_wifi": true}}
  }
}
