{
  "admin/services/samba4": {
    "action": {"type": "firstchild"},
    "depends": {"acl": ["luci-app-samba4"], "uci": {"samba4": true}}
  },
  "admin/services/samba4/settings": {
    "title": "共享设置", "order": 10,
    "action": {"type": "view", "path": "samba4"},
    "depends": {"acl": ["luci-app-samba4"], "uci": {"samba4": true}}
  },
  "admin/services/samba4/usb": {
    "title": "USB 文件共享", "order": 20,
    "action": {"type": "view", "path": "cudy-usb"},
    "depends": {"acl": ["luci-app-cudy-usb"]}
  },
  "admin/services/cudy-usb": {
    "action": {"type": "alias", "path": "admin/services/samba4/usb"},
    "depends": {"acl": ["luci-app-cudy-usb"]}
  }
}
