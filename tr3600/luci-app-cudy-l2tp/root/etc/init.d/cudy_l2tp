#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

vpn_firewall() {
	local section
	for section in cudy_l2tp_ike cudy_l2tp_esp cudy_l2tp_zone cudy_l2tp_lan cudy_l2tp_wan; do
		uci -q set "firewall.$section.enabled=$1" || return 1
	done
	uci -q commit firewall
	/etc/init.d/firewall reload
}

start_service() {
	umask 077
	vpn_firewall 0 || return 1
	[ "$(uci -q get cudy_l2tp.main.enabled)" = 1 ] || return 0
	mkdir -p /var/run/cudy-l2tp
	chmod 700 /var/run/cudy-l2tp
	/usr/libexec/cudy-l2tp-config /var/run/cudy-l2tp || return 1
	# Each daemon belongs only to this service, with separate runtime secrets.
	vpn_firewall 1 || return 1
	procd_open_instance ipsec
	procd_set_param command /usr/lib/ipsec/charon
	procd_set_param env STRONGSWAN_CONF=/var/run/cudy-l2tp/strongswan.conf
	procd_set_param file /var/run/cudy-l2tp/strongswan.conf /var/run/cudy-l2tp/swanctl.conf
	procd_set_param respawn
	procd_close_instance
	procd_open_instance l2tp
	procd_set_param command /usr/sbin/xl2tpd -D -l -p /var/run/cudy-l2tp/xl2tpd.pid -c /var/run/cudy-l2tp/xl2tpd.conf -C /var/run/cudy-l2tp/l2tp-control
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	vpn_firewall 0
	rm -f /var/run/cudy-l2tp/chap-secrets /var/run/cudy-l2tp/swanctl.conf
}

reload_service() { restart; }
service_triggers() { procd_add_reload_trigger cudy_l2tp; }

