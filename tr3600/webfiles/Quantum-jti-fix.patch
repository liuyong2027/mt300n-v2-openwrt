--- /dev/null
+++ b/backend/internal/auth/token_unique_test.go
@@ -0,0 +1,34 @@
+package auth
+
+import (
+	"github.com/golang-jwt/jwt/v4"
+	"github.com/gtsteffaniak/filebrowser/backend/internal/database/users"
+	"github.com/gtsteffaniak/filebrowser/backend/pkg/settings"
+	"testing"
+	"time"
+)
+
+func TestCudyUniqueJWTForConcurrentUsers(t *testing.T) {
+	old := settings.Config.Auth.Key
+	settings.Config.Auth.Key = "synthetic-jti-regression-key"
+	defer func() { settings.Config.Auth.Key = old }()
+	seen := map[string]bool{}
+	for i := 0; i < 200; i++ {
+		u := &users.User{FrontendUser: users.FrontendUser{Username: "test-reader"}}
+		token, _, e := MakeSignedTokenAPI(u, "session", 2*time.Hour, users.Permissions{}, true)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if seen[token] {
+			t.Fatal("session JWT collision")
+		}
+		seen[token] = true
+		claims := jwt.MapClaims{}
+		if _, e = jwt.ParseWithClaims(token, claims, func(*jwt.Token) (interface{}, error) { return []byte(settings.Config.Auth.Key), nil }); e != nil {
+			t.Fatal(e)
+		}
+		if len(claims["jti"].(string)) != 32 {
+			t.Fatal("missing unique JWT identifier")
+		}
+	}
+}
