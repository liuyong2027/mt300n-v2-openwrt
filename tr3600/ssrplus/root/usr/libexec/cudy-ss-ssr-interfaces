#!/bin/sh
# Use the existing SSR decision chains for the retained ZeroTier gateway.
# No second routing policy, DNS resolver or proxy core is introduced here.
set -eu
[ "$(uci -q get firewall.mango_zt_wan.enabled)" = 1 ] || exit 0
nft list chain inet ss_spec ss_spec_wan_ac >/dev/null 2>&1 || exit 0
if ! nft list chain inet ss_spec ss_spec_prerouting | grep -q 'Cudy ZeroTier gateway'; then
    nft add rule inet ss_spec ss_spec_prerouting iifname '"zt*"' meta l4proto tcp jump ss_spec_wan_ac comment '"Cudy ZeroTier gateway"'
fi
if nft list chain ip ss_spec_mangle ss_spec_tproxy >/dev/null 2>&1; then
    if ! nft list chain ip ss_spec_mangle prerouting | grep -q 'Cudy ZeroTier gateway'; then
        nft add rule ip ss_spec_mangle prerouting iifname '"zt*"' meta l4proto udp jump ss_spec_tproxy comment '"Cudy ZeroTier gateway"'
    fi
fi
