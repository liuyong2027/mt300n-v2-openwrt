#!/bin/sh
# All accepts are generated from successfully started SSR server_config rows.
set -eu
case "${1:-}" in prepare|add|reload|stop) ;; *) exit 2;; esac
mkdir -p /var/run/ssrplus /var/lock
exec 8>/var/lock/cudy-ssr-server-firewall.lock
flock -w 30 8
active=/var/run/ssrplus/server-access.active
batch=/var/run/ssrplus/server-access.nft
trap 'rm -f "$batch" "$batch.checked"' EXIT HUP INT TERM
[ -f "$active" ] || : >"$active"
if [ "$1" = stop ]; then
    : >"$active"
    for handle in $(nft -a list chain inet fw4 input 2>/dev/null | awk '/comment "Cudy SSR server access"/ { print $NF }'); do
        case "$handle" in ''|*[!0-9]*) exit 1;; esac
        nft delete rule inet fw4 input handle "$handle"
    done
    if nft list chain inet fw4 CUDY_SSR_SERVER >/dev/null 2>&1; then
        nft flush chain inet fw4 CUDY_SSR_SERVER
        nft delete chain inet fw4 CUDY_SSR_SERVER
    fi
    nft destroy table inet cudy_ssr_server
    exit 0
fi
if [ "$1" = prepare ]; then : >"$active"; fi
if [ "$1" = add ]; then
    case "${2:-}" in ''|*[!a-zA-Z0-9_]*) exit 2;; esac
    /usr/libexec/cudy-ssr-server-rules validate "$2"
    grep -qxF "$2" "$active" 2>/dev/null || printf '%s\n' "$2" >>"$active"
fi
nft list table inet fw4 >/dev/null
if ! nft list chain inet fw4 CUDY_SSR_SERVER >/dev/null 2>&1; then
    nft add chain inet fw4 CUDY_SSR_SERVER
fi
if ! nft list chain inet fw4 input | grep -q 'jump CUDY_SSR_SERVER'; then
    nft insert rule inet fw4 input jump CUDY_SSR_SERVER comment '"Cudy SSR server access"'
fi
/usr/libexec/cudy-ssr-server-rules rules "$active" >"$batch"
nft -c -f "$batch"
nft -f "$batch"
chmod 600 "$active"
