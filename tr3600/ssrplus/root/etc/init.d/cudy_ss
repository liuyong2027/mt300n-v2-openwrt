#!/bin/sh /etc/rc.common
START=98
STOP=14
USE_PROCD=1
start_service() {
    mkdir -p /var/run/cudy-ss
    rm -f /var/run/cudy-ss/service-stopped
    /usr/libexec/cudy-ss-zt-guard || return 1
    cudy_validation=$(/usr/libexec/cudy-ss-zt validate 2>&1) || :
    [ -z "$cudy_validation" ] || logger -t cudy-ss "$cudy_validation"
    /usr/libexec/cudy-ss-lock /etc/init.d/cudy_ss_core restart || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/cudy-ss-zt-watch
    procd_set_param respawn 3600 5 3
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    mkdir -p /var/run/cudy-ss
    touch /var/run/cudy-ss/service-stopped
    /usr/libexec/cudy-ss-zt-guard || logger -t cudy-ss 'Private SS ingress guard could not be refreshed during stop'
    /usr/libexec/cudy-ss-lock /etc/init.d/cudy_ss_core stop
}
reload_service() { restart; }
service_triggers() { procd_add_reload_trigger shadowsocksr zerotier; }

