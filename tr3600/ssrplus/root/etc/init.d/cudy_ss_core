#!/bin/sh /etc/rc.common
START=99
STOP=13
USE_PROCD=1
start_service() {
    /usr/libexec/cudy-ss-zt-guard || return 1
    /usr/libexec/cudy-ss-zt available || return 0
    mkdir -p /var/etc/cudy-ss
    chmod 700 /var/etc/cudy-ss
    /usr/libexec/cudy-ss-zt config > /var/etc/cudy-ss/config.new.json || return 1
    chmod 600 /var/etc/cudy-ss/config.new.json
    /usr/bin/xray run -test -config /var/etc/cudy-ss/config.new.json >/dev/null 2>&1 || return 1
    mv /var/etc/cudy-ss/config.new.json /var/etc/cudy-ss/config.json
    /usr/libexec/cudy-ss-netns start || return 1
    /usr/libexec/cudy-ss-gate refresh || return 1
    procd_open_instance
    procd_set_param command /sbin/ip netns exec cudy-ss /usr/bin/xray run -config /var/etc/cudy-ss/config.json
    procd_set_param respawn 60 5 5
    procd_set_param stderr 1
    procd_set_param file /var/etc/cudy-ss/config.json
    procd_close_instance
}
stop_service() {
    cudy_old_pids=$(/usr/libexec/cudy-ss-process snapshot)
}
service_stopped() {
    /usr/libexec/cudy-ss-process wait $cudy_old_pids || return 1
    /usr/libexec/cudy-ss-netns stop
}
reload_service() { restart; }

