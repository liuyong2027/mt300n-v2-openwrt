#!/bin/sh /etc/rc.common
START=98
STOP=14
USE_PROCD=1
start_service() {
    /usr/libexec/cudy-ssr-server-firewall reload || return 1
    /etc/init.d/cudy_ss_core start || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/cudy-ssr-server-watch
    procd_set_param respawn 3600 5 3
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    /etc/init.d/cudy_ss_core stop
    rm -f /var/run/cudy-ss/core-ready
    /usr/libexec/cudy-ssr-server-firewall reload || :
}
reload_service() {
    # Revoke established encrypted sessions when scope/transport/enable changes.
    # Access metadata intentionally does not enter the Xray JSON configuration.
    restart
}
service_triggers() { procd_add_reload_trigger shadowsocksr; }
