#!/bin/sh /etc/rc.common
START=99
STOP=13
USE_PROCD=1
start_service() {
    /usr/libexec/cudy-ssr-servers wanted || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/cudy-ssr-serve
    procd_set_param respawn 60 5 5
    procd_set_param term_timeout 15
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    cudy_old_pids=$(/usr/libexec/cudy-ss-process snapshot-all)
    rm -f /var/run/cudy-ss/core-ready
    /usr/libexec/cudy-ssr-server-firewall reload || :
}
service_stopped() {
    # A new core must not overwrite config or reuse the namespace before the
    # previous supervisor and child have actually exited.
    /usr/libexec/cudy-ss-process wait $cudy_old_pids || return 1
    /usr/libexec/cudy-ss-netns stop
}
reload_service() { restart; }
