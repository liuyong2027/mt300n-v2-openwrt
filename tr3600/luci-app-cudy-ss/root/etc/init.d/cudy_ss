#!/bin/sh /etc/rc.common
START=98
STOP=14
USE_PROCD=1
start_service() {
    if [ -x /usr/libexec/cudy-ss-worker ] && [ -d /etc/cudy-ss/ui-transaction ]; then
        /usr/libexec/mango-lock /usr/libexec/cudy-ss-worker recover || return 1
    fi
    /usr/libexec/cudy-ss-zt-guard || return 1
    [ "$(uci -q get cudy_ss.main.enabled)" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/cudy-ss-zt-watch
    procd_set_param respawn 3600 5 3
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() { restart; }
service_triggers() { procd_add_reload_trigger cudy_ss; }
# Stopping this watcher does not remove the access guard from a live core.
