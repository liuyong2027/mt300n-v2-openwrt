#!/bin/sh /etc/rc.common
# IKEv2 client with optional China IP split.
# On TR3600 dual-stack images the two egress engines are exclusive.
# Enabling IKEv2 stops SSR Plus+. Starting SSR Plus+ with a real node turns IKEv2 off.
# A manual IKEv2 disable does not start SSR.
START=95
STOP=10

CONF_DIR=${MANGO_IKEV2_STATE:-/var/etc/mango-ikev2}
XFRM_IF=xfrm-mango
IKE_ETC=${MANGO_IKEV2_ETC:-/etc/mango-ikev2}
DNSMASQ_INIT=${MANGO_IKEV2_DNSMASQ_INIT:-/etc/init.d/dnsmasq}
MANGO_IKEV2_LIFECYCLE=${MANGO_IKEV2_LIFECYCLE:-/usr/lib/mango-ikev2/lifecycle.sh}
MANGO_IKEV2_DNS_SH=${MANGO_IKEV2_DNS_SH:-$(dirname "$MANGO_IKEV2_LIFECYCLE")/dns.sh}
# shellcheck disable=SC1090
. "$MANGO_IKEV2_LIFECYCLE"
# shellcheck disable=SC1090
. "$MANGO_IKEV2_DNS_SH"

extra_command "status" "Show brief IKEv2 client state"

boot() {
    start
}

start() {
    mango_ikev2_apply
}

stop() {
    mango_ikev2_lifecycle_enter || return 1
    # Re-read under the lock. Stop still tears the tunnel down.
    enabled=$(uci -q get mango_ikev2.main.enabled || true)
    mode=$(uci -q get mango_ikev2.main.mode || true)
    mango_ikev2_teardown
}

reload() {
    mango_ikev2_apply
}

restart() {
    stop
    start
}

status() {
    echo "enabled=$(uci -q get mango_ikev2.main.enabled) mode=$(uci -q get mango_ikev2.main.mode)"
    ip link show "$XFRM_IF" 2>/dev/null || echo "xfrm: down"
    swanctl --list-sas 2>/dev/null || echo "sas: unavailable"
}

mango_ikev2_watch_stop() {
    local pidfile
    pidfile=${MANGO_IKEV2_WATCH_PID:-/var/run/mango-ikev2-watch.pid}
    if [ -f "$pidfile" ]; then
        kill "$(cat "$pidfile")" 2>/dev/null || :
        rm -f "$pidfile"
    fi
}

mango_ikev2_watch_start() {
    local watch pidfile
    watch=${MANGO_IKEV2_WATCH:-/usr/libexec/mango-ikev2-watch}
    pidfile=${MANGO_IKEV2_WATCH_PID:-/var/run/mango-ikev2-watch.pid}
    mango_ikev2_watch_stop
    # apply holds the lifecycle lock on fd 9 and exports LOCK_HELD.
    # The watchdog and its sleep/failover children must not inherit either,
    # or stop/reload/yield wait out the flock timeout and leave the tunnel up.
    (
        unset MANGO_IKEV2_LOCK_HELD || true
        exec 9>&- 2>/dev/null || true
        exec "$watch"
    ) >/dev/null 2>&1 &
    echo $! > "$pidfile"
}

mango_ikev2_teardown() {
    mango_ikev2_watch_stop
    swanctl --terminate --ike mango --timeout 3 2>/dev/null || :
    swanctl --terminate --ike mango2 --timeout 3 2>/dev/null || :
    swanctl --terminate --ike mango3 --timeout 3 2>/dev/null || :
    swanctl --unload-all 2>/dev/null || swanctl --unload-conns 2>/dev/null || :
    ip link del "$XFRM_IF" 2>/dev/null || :
    ip -4 rule del priority 10001 fwmark 0x101/0xffffffff table 101 2>/dev/null || :
    ip -4 route flush table 101 2>/dev/null || :
    ip -4 route del 1.1.1.1/32 dev xfrm-mango 2>/dev/null || :
    ip -4 route del 8.8.8.8/32 dev xfrm-mango 2>/dev/null || :
    nft delete table inet mango_ikev2 2>/dev/null || :
    rm -f "${MANGO_IKEV2_SWANCTL_DIR:-/etc/swanctl/conf.d}/mango.conf"
    mango_ikev2_dns_off || :
    "${MANGO_IKEV2_PEER_ENGINE:-/usr/libexec/mango-ikev2-peer-engine}" release || :
}

mango_ikev2_ensure_xfrm() {
    local ifid mtu tunlink
    ifid=$(uci -q get mango_ikev2.main.ifid || true)
    mtu=$(uci -q get mango_ikev2.main.xfrm_mtu || true)
    ifid=${ifid:-42}
    mtu=${mtu:-1280}
    tunlink=$(uci -q get network.wan.device || true)
    [ -n "$tunlink" ] || tunlink=$(uci -q get network.wan.ifname || true)
    [ -n "$tunlink" ] || tunlink=eth0
    if ip link show "$XFRM_IF" >/dev/null 2>&1; then
        # Keep any VIP. Callers flush only after the old SA is gone.
        ip link set "$XFRM_IF" mtu "$mtu" up || return 1
        return 0
    fi
    ip link add "$XFRM_IF" type xfrm dev "$tunlink" if_id "$ifid" || return 1
    ip link set "$XFRM_IF" mtu "$mtu" up || return 1
}

# EIP196 crypto_safexcel IRQ oopses during ESP on TR3600; keep software crypto.
mango_ikev2_prefer_soft_crypto() {
    # Best effort. A missing modprobe.d must not abort the tunnel start.
    mkdir -p /etc/modprobe.d 2>/dev/null || return 0
    if [ ! -f /etc/modprobe.d/blacklist-crypto-safexcel.conf ]; then
        printf '%s\n' 'blacklist crypto_safexcel' > /etc/modprobe.d/blacklist-crypto-safexcel.conf 2>/dev/null || return 0
    fi
    if [ -f /etc/modules.d/90-crypto-hw-safexcel ]; then
        mv /etc/modules.d/90-crypto-hw-safexcel /etc/modules.d/90-crypto-hw-safexcel.disabled 2>/dev/null || :
    fi
    if grep -q '^crypto_safexcel ' /proc/modules 2>/dev/null; then
        rmmod crypto_safexcel 2>/dev/null || :
    fi
}

# strongswan and strongswan-swanctl each start charon. The starter keeps
# the pid, swanctl then gets "already running", and vici never loads the CA.
mango_ikev2_claim_charon() {
    if [ -x /etc/init.d/ipsec ]; then
        /etc/init.d/ipsec disable 2>/dev/null || :
        /etc/init.d/ipsec stop 2>/dev/null || :
    fi
}

mango_ikev2_wait_vici() {
    local i=0
    while [ "$i" -lt 30 ]; do
        if [ -S "${MANGO_IKEV2_VICI:-/var/run/charon.vici}" ] && pidof charon >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

mango_ikev2_load_all() {
    local i=0
    while [ "$i" -lt 12 ]; do
        if swanctl --load-all --noprompt >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    swanctl --load-all --noprompt
}

mango_ikev2_sa_present() {
    swanctl --list-sas 2>/dev/null | grep -E -q '^[A-Za-z][A-Za-z0-9_]*: .*(ESTABLISHED|CONNECTING|REKEYING),'
}

mango_ikev2_wait_sa_gone() {
    local i=0 max=20 pause extra
    pause=${MANGO_IKEV2_SA_POLL:-1}
    extra=${MANGO_IKEV2_POST_TERM_WAIT:-15}
    case "$pause" in ''|*[!0-9]*) pause=1 ;; esac
    case "$extra" in ''|*[!0-9]*) extra=15 ;; esac
    while [ "$i" -lt "$max" ]; do
        mango_ikev2_sa_present || break
        i=$((i + 1))
        [ "$pause" -gt 0 ] && sleep "$pause" || true
    done
    if [ "$extra" -gt 0 ]; then
        sleep "$extra"
    fi
}

mango_ikev2_terminate_all() {
    swanctl --terminate --ike mango --timeout 3 >/dev/null 2>&1 || :
    swanctl --terminate --ike mango2 --timeout 3 >/dev/null 2>&1 || :
    swanctl --terminate --ike mango3 --timeout 3 >/dev/null 2>&1 || :
}

# 0 config changed and installed, 2 unchanged, 1 failure (old file kept).
mango_ikev2_stage_swanctl() {
    local gen tmp dir
    gen=${MANGO_IKEV2_GENERATE:-/usr/libexec/mango-ikev2-generate}
    dir=${MANGO_IKEV2_SWANCTL_DIR:-/etc/swanctl/conf.d}
    mkdir -p "$CONF_DIR" "$dir" || return 1
    tmp=$(mktemp "$CONF_DIR/swanctl.XXXXXX") || return 1
    if ! "$gen" swanctl > "$tmp" || [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        echo 'swanctl generate failed' >&2
        return 1
    fi
    if [ -f "$CONF_DIR/swanctl.conf" ] && cmp -s "$tmp" "$CONF_DIR/swanctl.conf"; then
        rm -f "$tmp"
        return 2
    fi
    printf '%s\n' "$tmp"
    return 0
}

mango_ikev2_install_swanctl() {
    local tmp dir
    tmp=$1
    dir=${MANGO_IKEV2_SWANCTL_DIR:-/etc/swanctl/conf.d}
    mv "$tmp" "$CONF_DIR/swanctl.conf" || return 1
    ln -sfn "$CONF_DIR/swanctl.conf" "$dir/mango.conf" || return 1
    swanctl --load-conns --noprompt >/dev/null 2>&1 || swanctl --load-all --noprompt >/dev/null 2>&1
}

mango_ikev2_flush_vip_if_clear() {
    if mango_ikev2_sa_present; then
        echo 'IKE SA still present; not flushing VIP' >&2
        return 1
    fi
    ip -4 addr flush dev "$XFRM_IF" 2>/dev/null || true
}

mango_ikev2_apply() {
    local enabled mode staged rc same
    mango_ikev2_lifecycle_enter || return 1
    mkdir -p "$CONF_DIR" "$IKE_ETC" "${MANGO_IKEV2_SWANCTL_DIR:-/etc/swanctl/conf.d}"
    mango_ikev2_prefer_soft_crypto
    mango_ikev2_claim_charon
    # Re-check under the lock. A stop that ran first must not be dialed over.
    enabled=$(uci -q get mango_ikev2.main.enabled || true)
    mode=$(uci -q get mango_ikev2.main.mode || true)
    # echo goes to LuCI fs.exec stderr and is dropped. logread needs this.
    command -v logger >/dev/null 2>&1 && \
        logger -t mango_ikev2 "apply enabled=${enabled:-unset} mode=${mode:-unset}" || true
    if [ "$enabled" != 1 ]; then
        mango_ikev2_teardown
        "${MANGO_IKEV2_FW:-/usr/libexec/mango-ikev2-fw}" || :
        return 0
    fi
    # Any enabled IKEv2 mode owns WAN egress; stop SSR Plus+ client.
    "${MANGO_IKEV2_PEER_ENGINE:-/usr/libexec/mango-ikev2-peer-engine}" claim || :
    if [ "$mode" = direct ]; then
        mango_ikev2_watch_stop
        swanctl --terminate --ike mango --timeout 3 2>/dev/null || :
        swanctl --terminate --ike mango2 --timeout 3 2>/dev/null || :
        swanctl --terminate --ike mango3 --timeout 3 2>/dev/null || :
        ip link del "$XFRM_IF" 2>/dev/null || :
        mango_ikev2_dns_off || return 1
        "${MANGO_IKEV2_FW:-/usr/libexec/mango-ikev2-fw}" || return 1
        return 0
    fi
    if [ ! -s "$IKE_ETC/cn-cidrs.txt" ] && [ "$mode" = split ]; then
        /usr/libexec/mango-ikev2-cn-update || {
            echo 'split 模式需要中国 IP 列表，请先更新' >&2
            return 1
        }
    fi
    if [ "$mode" = gfw ] && [ ! -s "$IKE_ETC/gfw-domains.txt" ]; then
        /usr/libexec/mango-ikev2-gfw-update || {
            echo 'gfw 模式需要域名列表，请先更新' >&2
            return 1
        }
    fi
    staged=$(mango_ikev2_stage_swanctl) || rc=$?
    rc=${rc:-0}
    if [ "$rc" = 1 ]; then
        # WAN may not be ready at boot. Keep the watchdog so a later tick
        # can generate again. Do not install a config or claim connected.
        echo 'swanctl generate failed; watchdog will retry' >&2
        mango_ikev2_watch_start
        return 1
    fi
    same=0
    [ "$rc" = 2 ] && same=1
    if [ "$same" = 1 ] && mango_ikev2_sa_present; then
        # Reload with the same swanctl text keeps the live VIP.
        mango_ikev2_ensure_xfrm || return 1
        "${MANGO_IKEV2_FW:-/usr/libexec/mango-ikev2-fw}" || return 1
        mango_ikev2_dns_on || return 1
        "${MANGO_IKEV2_FAILOVER:-/usr/libexec/mango-ikev2-failover}" || true
        mango_ikev2_watch_start
        return 0
    fi
    if mango_ikev2_sa_present; then
        mango_ikev2_terminate_all
        mango_ikev2_wait_sa_gone
        if mango_ikev2_sa_present; then
            rm -f "$staged"
            echo 'IKE SA still present after terminate; not flushing' >&2
            return 1
        fi
    fi
    if [ "$same" != 1 ]; then
        mango_ikev2_install_swanctl "$staged" || return 1
    fi
    /etc/init.d/swanctl enable 2>/dev/null || :
    # Do not restart a live charon: that races S95 load-all against vici.
    if pidof charon >/dev/null 2>&1; then
        :
    else
        /etc/init.d/swanctl start 2>/dev/null || /etc/init.d/swanctl restart || return 1
    fi
    mango_ikev2_wait_vici || return 1
    mango_ikev2_load_all || return 1
    mango_ikev2_ensure_xfrm || return 1
    # Install the nft set before dnsmasq starts adding GFW answers into it.
    "${MANGO_IKEV2_FW:-/usr/libexec/mango-ikev2-fw}" || return 1
    mango_ikev2_dns_on || return 1
    echo mango > "$CONF_DIR/active"
    echo 0 > "$CONF_DIR/fail-count"
    echo 0 > "$CONF_DIR/fallback-fail"
    mango_ikev2_flush_vip_if_clear || return 1
    "${MANGO_IKEV2_FAILOVER:-/usr/libexec/mango-ikev2-failover}" || true
    mango_ikev2_watch_start
}
