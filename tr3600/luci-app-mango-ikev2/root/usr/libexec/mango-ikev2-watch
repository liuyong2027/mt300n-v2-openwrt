#!/bin/sh
# Recheck the active IKEv2 server every 30 seconds.
# The parent closes the lifecycle lock fd before exec. Kill the sleep
# child on the way out so stop does not leave it holding anything.
child=
trap 'if [ -n "$child" ]; then kill "$child" 2>/dev/null || true; fi; exit 0' TERM INT
while true; do
    sleep 30 &
    child=$!
    wait "$child" || exit 0
    child=
    /usr/libexec/mango-ikev2-failover || true
done
