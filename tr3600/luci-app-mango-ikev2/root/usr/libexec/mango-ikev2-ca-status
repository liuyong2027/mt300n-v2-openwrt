#!/bin/sh
# Print CA install status for LuCI (key=value lines).
# Reports the installed file's real subject, not a hard-coded vendor name.
set -eu

LIBDIR=${MANGO_IKEV2_LIBDIR:-/usr/lib/mango-ikev2}
# shellcheck disable=SC1091
. "$LIBDIR/ca-paths.sh"

mango_ikev2_ca_migrate

printf 'path=%s\n' "$CA_SWAN"
printf 'path_legacy=%s\n' "$CA_IPSEC"

if [ -s "$CA_SWAN" ]; then
	printf 'present=1\n'
	printf 'size=%s\n' "$(wc -c < "$CA_SWAN" | tr -d ' \n')"
	printf 'mtime=%s\n' "$(date -r "$CA_SWAN" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo -)"
else
	printf 'present=0\n'
	printf 'size=0\n'
	printf 'mtime=-\n'
fi

if [ -s "$CA_IPSEC" ]; then
	printf 'legacy_present=1\n'
else
	printf 'legacy_present=0\n'
fi

subject='-'
not_after='-'
loaded=0
file_text=
if [ -s "$CA_SWAN" ]; then
	file_text=$(mango_ikev2_file_subject_text "$CA_SWAN" || true)
	file_subject=$(printf '%s\n' "$file_text" | mango_ikev2_parse_subject_line)
	file_not_after=$(printf '%s\n' "$file_text" | mango_ikev2_parse_not_after_line)
	[ -n "$file_subject" ] && subject=$file_subject
	[ -n "$file_not_after" ] && not_after=$file_not_after
fi

if [ -s "$CA_SWAN" ]; then
	body=$(mango_ikev2_pem_bodies < "$CA_SWAN" | head -n 1)
	if [ -z "$body" ]; then
		body=$(base64 "$CA_SWAN" | tr -d '[:space:]')
	fi
	if [ -n "$body" ] && swanctl --list-certs --type x509 --flag ca --pem 2>/dev/null | \
		mango_ikev2_pem_bodies | grep -Fqx -- "$body"; then
		loaded=1
	fi
fi

[ -n "$subject" ] || subject='-'
[ -n "$not_after" ] || not_after='-'
printf 'loaded=%s\n' "$loaded"
printf 'subject=%s\n' "$subject"
printf 'not_after=%s\n' "$not_after"
