#!/bin/sh
# Connectivity probe for LuCI. usage: mango-ikev2-probe [baidu|google|all]
set -eu

probe_one() {
	local name="$1" url="$2" via="$3" iface="$4"
	local out code ms ok=0
	if [ -n "$iface" ] && ip link show "$iface" >/dev/null 2>&1; then
		out=$(curl -s -o /dev/null -w '%{http_code} %{time_total}' \
			--connect-timeout 5 --max-time 10 --interface "$iface" "$url" 2>/dev/null || echo '000 0')
	else
		out=$(curl -s -o /dev/null -w '%{http_code} %{time_total}' \
			--connect-timeout 5 --max-time 10 "$url" 2>/dev/null || echo '000 0')
		via=wan
	fi
	code=$(printf '%s' "$out" | awk '{print $1}')
	ms=$(printf '%s' "$out" | awk '{printf "%d", ($2+0)*1000}')
	case "$code" in
		200|204|301|302) ok=1 ;;
	esac
	printf 'target=%s\n' "$name"
	printf 'ok=%s\n' "$ok"
	printf 'http=%s\n' "$code"
	printf 'ms=%s\n' "$ms"
	printf 'via=%s\n' "$via"
}

target=${1:-all}
case "$target" in
	baidu)
		# Domestic path: default/WAN (not forced into VPN).
		probe_one baidu 'https://www.baidu.com' wan ''
		;;
	google)
		# Foreign path: force tunnel interface.
		probe_one google 'https://www.google.com/generate_204' vpn xfrm-mango
		;;
	all)
		probe_one baidu 'https://www.baidu.com' wan ''
		printf -- '---\n'
		probe_one google 'https://www.google.com/generate_204' vpn xfrm-mango
		;;
	*)
		echo "usage: $0 baidu|google|all" >&2
		exit 2
		;;
esac
