#!/usr/bin/lua
local j = require('luci.jsonc')
local function fail()
    io.stderr:write('Dynu encrypted DNS resolution failed\n')
    os.exit(1)
end
local function public_ip(v)
    if type(v) ~= 'string' then return false end
    local a,b,c,d = v:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
    if not a then return false end
    a,b,c,d = tonumber(a),tonumber(b),tonumber(c),tonumber(d)
    if a>255 or b>255 or c>255 or d>255 then return false end
    if a==0 or a==10 or a==127 or a>=224 or (a==100 and b>=64 and b<=127)
       or (a==169 and b==254) or (a==172 and b>=16 and b<=31)
       or (a==192 and b==168) or (a==192 and b==0 and (c==0 or c==2))
       or (a==198 and (b==18 or b==19)) or (a==198 and b==51 and c==100)
       or (a==203 and b==0 and c==113) then return false end
    return true
end
if arg[1]=='--public-ip' then os.exit(public_ip(arg[2]) and 0 or 1) end
local data
if arg[1]=='--validate-json' then
    data=io.read(65537)
else
    if arg[1] then fail() end
    local p=io.popen([[ubus call network.interface.wan status '{}' 2>/dev/null]])
    if not p then fail() end
    local wan=j.parse(p:read(65537) or '');p:close()
    local dev=wan and wan.l3_device
    if not wan or not wan.up or type(dev)~='string' or #dev>32 or not dev:match('^[%w_.%-]+$') then fail() end
    local command="/usr/bin/curl -4 --interface '"..dev.."' --noproxy '*' --connect-timeout 4 --max-time 8 --cacert /etc/ssl/certs/ca-certificates.crt -fsS 'https://doh.pub/resolve?name=api.dynu.com&type=A' 2>/dev/null"
    p=io.popen(command)
    if not p then fail() end
    data=p:read(65537);local ok=p:close()
    if not ok then fail() end
end
if not data or #data>65536 then fail() end
local v=j.parse(data)
if type(v)~='table' or v.Status~=0 or v.TC==true or type(v.Answer)~='table' then fail() end
local found,seen={},{}
for _,a in ipairs(v.Answer)do
    if type(a)=='table' and a.type==1 and type(a.name)=='string'
       and a.name:lower():gsub('%.$','')=='api.dynu.com' and public_ip(a.data) and not seen[a.data] then
        seen[a.data]=true;found[#found+1]=a.data
        if #found>=4 then break end
    end
end
if #found==0 then fail() end
for _,ip in ipairs(found)do print(ip)end
